def get_grade(score):
    if score >= 90:
        return "A"
    elif score >= 80:
        return "B"
    elif score >= 70:
        return "C"
    elif score >= 60:
        return "D"
    else:
        return "F"


test_scores = [95, 88, 73, 61, 45, 100, 0]

for score in test_scores:
    print(f"Score: {score} -> Grade: {get_grade(score)}") 
